PxSEL1[1] = 0;
PxSEL0[4] = 0;
PxSEL1[4] = 0;
14. Write a void function named Buttons_Init that configures the following pins as GPIO inputs with pull-down resistors enabled.
    • P3.1, P3.6, P5.0, P5.4
void Buttons_Init(void){
  PxSEL0[1] = 0;
  PxSEL1[1] = 0;
  PxSEL0[4] = 0;
  PxSEL1[4] = 0;
  PxSEL0[1] = 0;
  PxSEL1[1] = 0;
  PxSEL0[4] = 0;
  PxSEL1[4] = 0;
  
}
